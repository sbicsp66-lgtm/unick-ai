# ───────── App ─────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───────── Supabase ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by webhooks, cron jobs and OAuth callbacks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── Secrets encryption (AES-256-GCM for stored OAuth tokens) ─────────
# 32 bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ───────── AI providers (set at least one) ─────────
AI_DEFAULT_PROVIDER=anthropic        # anthropic | openai | google
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ───────── Image generation ─────────
IMAGE_DEFAULT_PROVIDER=flux          # flux | dalle | ideogram
FAL_API_KEY=                         # Flux via fal.ai
IDEOGRAM_API_KEY=
# DALL·E uses OPENAI_API_KEY

# ───────── Google (Business Profile + Ads) ─────────
GOOGLE_OAUTH_CLIENT_ID=              # separate OAuth client for business.manage scope
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ───────── Meta (WhatsApp Cloud API + Marketing API + Pages/Instagram) ─────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=           # any random string, entered in Meta dashboard
WHATSAPP_GRAPH_API_VERSION=v21.0

# ───────── Razorpay ─────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ───────── Dashboard data ─────────
# mock = sample data (default, safe for demos)   live = real data from Supabase
DASHBOARD_DATA_SOURCE=mock

# ───────── Google Business Profile data ─────────
# mock = sample data (only option for now)
GBP_DATA_SOURCE=mock

# ───────── Creative Studio ─────────
# mock = sample text/images and simulated publishing (only option for now)
CREATIVE_DATA_SOURCE=mock

# ───────── Cron (Vercel Cron → /api/cron/*) ─────────
CRON_SECRET=
